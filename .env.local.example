# Copy this file to .env.local and provide your OpenAI API key.

# SurrealDB
# docker-compose.yml exposes the container on localhost:8001.
DATABASE_URL=ws://localhost:8001/rpc
SURREALDB_NS=rag_tutor
SURREALDB_DB=rag_tutor
SURREALDB_USER=root
SURREALDB_PASS=root

# FastAPI server
TUTOR_SERVER_PORT=8005

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Retrieval
RAG_TOP_K=5
KB_PATH=kb/doc
MAX_PDF_SIZE_MB=200
